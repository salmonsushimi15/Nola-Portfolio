---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionNumber from "./SectionNumber.astro";

/**
 * Grid card for /projects. Two visual modes:
 *  - photo cover: pass `image` (a statically-imported ImageMetadata)
 *  - typographic cover: omit `image` — used for #07-09 per client decision
 *    (no renders available; terracotta panel + number + title instead of a placeholder photo).
 */
interface Props {
  number: number;
  title: string;
  category: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { number, title, category, href, image, imageAlt } = Astro.props;
---

<a
  href={href}
  class="group relative flex flex-col overflow-hidden bg-cream-panel transition-shadow duration-300 hover:shadow-xl focus-visible:shadow-xl"
>
  <div class="aspect-[4/3] w-full overflow-hidden">
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? title}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 33vw, 100vw"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full flex-col items-center justify-center gap-4 bg-terracotta p-6 text-center">
          <SectionNumber number={number} tone="inverted" size="lg" />
          <p class="label-caps max-w-[16ch] text-sm text-white">{title}</p>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-2 p-5">
    <SectionNumber number={number} label={category} size="sm" />
    <h3 class="text-xl font-semibold text-ink transition-colors group-hover:text-terracotta-deep">
      {title}
    </h3>
  </div>
</a>
