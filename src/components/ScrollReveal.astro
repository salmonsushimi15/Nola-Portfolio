---
/**
 * Shared scroll-reveal engine (Revisi klien putaran 2A, poin 3).
 *
 * Originally lived as a one-off inline script tag inside HomeTemplate.astro,
 * so About/Projects/Contact/Resume/project-detail pages had matching
 * `[data-reveal]` CSS (global.css) but no observer to ever flip `.is-visible`
 * on. Centralized here and mounted once in Base.astro so every page gets it
 * automatically — no per-template wiring needed.
 *
 * Behavior (unchanged from the original): runs once per element (unobserve
 * after reveal), re-initializes on every `astro:page-load` so it keeps
 * working after a client-side `<ClientRouter />` navigation, falls back to
 * showing everything immediately with no IntersectionObserver support or
 * `prefers-reduced-motion: reduce`.
 */
---

<script>
  document.addEventListener("astro:page-load", () => {
    const targets = document.querySelectorAll("[data-reveal]:not(.is-visible)");
    if (targets.length === 0) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (!("IntersectionObserver" in window) || prefersReducedMotion) {
      targets.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
    );

    targets.forEach((el) => observer.observe(el));
  });
</script>
