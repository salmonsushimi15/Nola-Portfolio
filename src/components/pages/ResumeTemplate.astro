---
import { getLocalizedPath, type Lang } from "../../i18n/paths";
import type { resume as resumeEn } from "../../i18n/en/resume";

interface Props {
  lang: Lang;
  content: typeof resumeEn;
}

const { lang, content: resume } = Astro.props;
// resume.download.href is a static PDF asset (not a page route) — never
// pass it through getLocalizedPath. The "About page" link IS a page route.
const aboutHref = getLocalizedPath("/about", lang);
---

<section class="content-wrap grid gap-12 py-16 sm:py-20 md:grid-cols-[1fr_0.8fr] md:items-start md:py-24">
  <div>
    <p class="label-caps text-sm text-terracotta-deep">{resume.eyebrow}</p>
    <h1 class="mt-4 text-4xl font-bold sm:text-5xl">{resume.heading}</h1>
    <p class="mt-6 max-w-md text-base text-ink/70 sm:text-lg">{resume.lead}</p>

    <a
      href={resume.download.href}
      download={resume.download.filename}
      class="mt-8 inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-terracotta px-6 text-sm font-semibold text-cream transition-colors hover:bg-terracotta-deep"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 15V3" />
        <path d="m7 10 5 5 5-5" />
        <path d="M20 21H4" />
      </svg>
      {resume.download.label}
    </a>
    <p class="mt-3 text-xs text-ink/50">{resume.download.meta}</p>
  </div>

  <div class="bg-cream-panel p-6 sm:p-8">
    <h2 class="label-caps text-xs text-ink/60">{resume.snapshot.label}</h2>

    <div class="mt-5">
      <p class="label-caps text-xs text-terracotta-deep">{resume.snapshot.currentRoleLabel}</p>
      <p class="mt-1 font-semibold text-ink">{resume.snapshot.role.title}</p>
      <p class="text-sm text-ink/70">{resume.snapshot.role.detail}</p>
    </div>

    <div class="mt-6">
      <p class="label-caps text-xs text-terracotta-deep">{resume.snapshot.educationLabel}</p>
      <ul class="mt-2 flex flex-col gap-1.5 text-sm text-ink/80">
        {resume.snapshot.education.map((line) => <li>{line}</li>)}
      </ul>
    </div>

    <div class="mt-6">
      <p class="label-caps text-xs text-terracotta-deep">{resume.snapshot.softwareLabel}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          resume.snapshot.skills.map((skill) => (
            <li class="rounded-full bg-cream px-3 py-1.5 text-sm text-ink">{skill}</li>
          ))
        }
      </ul>
    </div>

    <a
      href={aboutHref}
      class="label-caps mt-8 inline-flex min-h-11 items-center gap-2 text-xs text-terracotta-deep transition-colors hover:text-terracotta"
    >
      {resume.snapshot.aboutLinkLabel}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</section>
