---
import { Image } from "astro:assets";
import SectionNumber from "../SectionNumber.astro";
import {
  projects,
  getFeaturedCover,
  getGalleryImages,
  buildGalleryRows,
  chunkConceptParagraphs,
  type ProjectMeta,
} from "../../lib/projects";
import { getUi } from "../../i18n/getUi";
import { getProjectsCopy, getCategoryLabel } from "../../i18n/getProjectsCopy";
import { getLocalizedPath, type Lang } from "../../i18n/paths";

interface Props {
  lang: Lang;
  project: ProjectMeta;
}

const { lang, project } = Astro.props;
const t = getUi(lang);
const p = (path: string) => getLocalizedPath(path, lang);

const copy = getProjectsCopy(lang)[project.slug];
const categoryLabel = getCategoryLabel(project, lang);

const cover = project.hasRenders ? getFeaturedCover(project.slug) : undefined;
const galleryRows = project.hasRenders
  ? buildGalleryRows(getGalleryImages(project.slug))
  : [];

const currentIndex = projects.findIndex((proj) => proj.slug === project.slug);
const prevProject = projects[(currentIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(currentIndex + 1) % projects.length];

const numberDisplay = String(project.number).padStart(2, "0");

// Revisi klien putaran 2A, poin 4: same transition:name scheme as
// ProjectCard.astro (`project-image-${slug}` / `project-title-${slug}`) so
// View Transitions morphs the clicked card's cover straight into this hero
// (photo -> photo for 01-06, terracotta panel -> terracotta panel for
// 07-09), instead of a plain cross-fade. Unchanged in the book layout below
// — both elements still live on "page 1" (the cover), just re-laid-out.
const imageTransitionName = `project-image-${project.slug}`;
const titleTransitionName = `project-title-${project.slug}`;

/**
 * Book-style detail page (Revisi klien putaran 2B). Every project's content
 * is assembled into a flat, ordered list of "book pages" — all rendered to
 * the DOM unconditionally (SEO / no-JS requirement), then paginated by CSS
 * + a small vanilla-JS state machine (see the script block near the end of
 * this file):
 *
 *   1. cover        — hero image/panel, big number, title (h1), category, summary
 *   2..n. concept    — 1-2 pages of narrative paragraphs (chunkConceptParagraphs)
 *   n+1. deliverables (only when the project has one, e.g. 08 Revit Modeling)
 *   ...  gallery     — one book page per buildGalleryRows() row (1-2 renders each)
 *   last. nav        — prev/next PROJECT (wrap-around) + back-to-index link
 *
 * `data-reveal` (the scroll-in-view fade used elsewhere on the site) is
 * deliberately NOT used inside book pages: since inactive pages sit
 * geometrically in the same viewport rect as the active one (just
 * opacity:0), the IntersectionObserver would fire for all of them near-
 * simultaneously on load instead of once per page-turn. The flip/slide
 * transition itself is this template's "reveal" motion.
 */
type BookPage =
  | { kind: "cover" }
  | { kind: "concept"; paragraphs: string[] }
  | { kind: "deliverables"; items: string[] }
  | { kind: "gallery"; images: (typeof galleryRows)[number] }
  | { kind: "nav" };

const conceptPages: BookPage[] = chunkConceptParagraphs(copy.concept).map((paragraphs) => ({
  kind: "concept",
  paragraphs,
}));
const deliverablesPages: BookPage[] = copy.deliverables
  ? [{ kind: "deliverables", items: copy.deliverables }]
  : [];
const galleryPages: BookPage[] = galleryRows.map((images) => ({ kind: "gallery", images }));

const bookPages: BookPage[] = [
  { kind: "cover" },
  ...conceptPages,
  ...deliverablesPages,
  ...galleryPages,
  { kind: "nav" },
];
const totalPages = bookPages.length;

const bookId = `book-${project.slug}`;
---

<div
  class="book"
  data-book
  id={bookId}
  data-page-label={t.projectDetail.book.pageLabel}
  data-of-label={t.projectDetail.book.of}
>
  <div class="book__stage" data-book-stage>
    {
      bookPages.map((page, index) => (
        <section
          class:list={["book__page", index === 0 && "is-active"]}
          data-book-page
          tabindex="-1"
        >
          <div class="book__page-inner">
            {page.kind === "cover" && (
              <div class="book__cover">
                <div class="book__cover-media">
                  {cover ? (
                    <Image
                      src={cover}
                      alt={`${project.title} — ${t.projectDetail.heroImageAlt}`}
                      class="h-full w-full object-cover"
                      widths={[600, 1000, 1600, 2000]}
                      sizes="100vw"
                      loading="eager"
                      fetchpriority="high"
                      transition:name={imageTransitionName}
                    />
                  ) : (
                    <div
                      class="flex h-full w-full flex-col items-center justify-center gap-6 bg-terracotta px-6 text-center"
                      transition:name={imageTransitionName}
                    >
                      <SectionNumber number={project.number} tone="inverted" size="lg" />
                      <p class="label-caps max-w-md text-sm text-white sm:text-base">
                        {project.title}
                      </p>
                    </div>
                  )}
                </div>
                <div class="book__cover-text content-wrap">
                  <span
                    aria-hidden="true"
                    class="block text-5xl font-bold leading-none text-terracotta tabular-nums sm:text-6xl"
                  >
                    {numberDisplay}
                  </span>
                  <p class="label-caps-natural mt-3 text-xs text-terracotta-deep">
                    {categoryLabel}
                  </p>
                  <h1
                    class="mt-2 max-w-2xl text-3xl font-bold sm:text-4xl md:text-5xl"
                    transition:name={titleTransitionName}
                  >
                    {project.title}
                  </h1>
                  <p class="mt-4 max-w-2xl text-sm text-ink/70 sm:text-base">{copy.summary}</p>
                </div>
              </div>
            )}

            {page.kind === "concept" && (
              <div class="book__text content-wrap">
                <h2 class="label-caps text-xs text-ink/60">
                  {t.projectDetail.conceptHeading}
                </h2>
                <div class="book__text-body">
                  {page.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </div>
            )}

            {page.kind === "deliverables" && (
              <div class="book__text content-wrap">
                <h3 class="label-caps text-xs text-terracotta-deep">
                  {t.projectDetail.deliverablesHeading}
                </h3>
                <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                  {page.items.map((item) => (
                    <li class="flex items-center gap-3 bg-cream-panel px-4 py-3 text-sm text-ink">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="shrink-0 text-terracotta"
                      >
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {page.kind === "gallery" && (
              <div
                class:list={[
                  "book__gallery",
                  page.images.length === 1 && "book__gallery--single",
                ]}
              >
                {page.images.map((img) => (
                  <div class="book__gallery-figure">
                    <Image
                      src={img}
                      alt={`${project.title} — ${t.projectDetail.renderAlt}`}
                      class="h-full w-full object-cover"
                      widths={[500, 900, 1400, 2000]}
                      sizes={page.images.length === 1 ? "100vw" : "(min-width: 640px) 50vw, 100vw"}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ))}
              </div>
            )}

            {page.kind === "nav" && (
              <div class="book__nav content-wrap">
                <nav aria-label="Other projects" class="grid gap-4 sm:grid-cols-2">
                  <a
                    href={p(`/projects/${prevProject.slug}`)}
                    class="group flex min-h-11 items-center gap-4 border border-ink/15 p-5 transition-colors hover:border-terracotta-deep"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-terracotta"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    <span aria-hidden="true" class="text-2xl font-bold text-terracotta tabular-nums">
                      {String(prevProject.number).padStart(2, "0")}
                    </span>
                    <span class="flex flex-col">
                      <span class="label-caps text-xs text-ink/50">{t.projectDetail.previousLabel}</span>
                      <span class="text-base font-semibold text-ink transition-colors group-hover:text-terracotta-deep">
                        {prevProject.title}
                      </span>
                    </span>
                  </a>

                  <a
                    href={p(`/projects/${nextProject.slug}`)}
                    class="group flex min-h-11 items-center justify-end gap-4 border border-ink/15 p-5 text-right transition-colors hover:border-terracotta-deep"
                  >
                    <span class="flex flex-col items-end">
                      <span class="label-caps text-xs text-ink/50">{t.projectDetail.nextLabel}</span>
                      <span class="text-base font-semibold text-ink transition-colors group-hover:text-terracotta-deep">
                        {nextProject.title}
                      </span>
                    </span>
                    <span aria-hidden="true" class="text-2xl font-bold text-terracotta tabular-nums">
                      {String(nextProject.number).padStart(2, "0")}
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-terracotta"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                </nav>

                <a
                  href={p("/projects")}
                  class="label-caps mt-6 inline-flex min-h-11 items-center gap-2 text-xs text-terracotta-deep transition-colors hover:text-terracotta"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
                  {t.projectDetail.allProjectsLabel}
                </a>
              </div>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <!-- Page-flip controls — hidden until .js (Base.astro) confirms JS is
       running; a no-JS visitor gets the plain stacked fallback instead
       (see the book__controls CSS in global.css).

       Putaran 3, poin C: klien melaporkan prev/next PROYEK "hilang" karena
       dulu (sebelum jadi buku) selalu terlihat di bawah halaman, sedangkan
       sekarang hanya ada di halaman "nav" terakhir buku. Fix: tambahkan link
       kompak prev/next PROYEK yang selalu terlihat di bar kontrol ini,
       diberi gaya BERBEDA secara sengaja dari tombol panah HALAMAN
       (book__nav-btn = tombol bulat berbingkai di tengah) supaya tidak
       tertukar — book__project-nav adalah TEKS+panah kecil di kedua ujung
       bar, tanpa bingkai bulat. Halaman "nav" terakhir (full prev/next +
       back-to-index) tetap dipertahankan apa adanya. -->
  <div class="book__controls content-wrap" data-book-controls>
    <a
      href={p(`/projects/${prevProject.slug}`)}
      class="book__project-nav book__project-nav--prev"
      aria-label={`${t.projectDetail.book.prevProject}: ${prevProject.title}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/></svg>
      <span class="book__project-nav-text">
        <span class="label-caps book__project-nav-label">{t.projectDetail.book.prevProject}</span>
        <span class="book__project-nav-title">
          <span aria-hidden="true">{String(prevProject.number).padStart(2, "0")}</span>
          <span class="book__project-nav-name">{prevProject.title}</span>
        </span>
      </span>
    </a>

    <div class="book__page-group">
      <button
        type="button"
        class="book__nav-btn"
        data-book-prev
        aria-label={t.projectDetail.book.prevPage}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <p class="book__indicator label-caps" aria-live="polite">
        <span aria-hidden="true" data-book-indicator-num>01 / {String(totalPages).padStart(2, "0")}</span>
        <span class="sr-only" data-book-indicator-sr />
      </p>

      <button
        type="button"
        class="book__nav-btn"
        data-book-next
        aria-label={t.projectDetail.book.nextPage}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    <a
      href={p(`/projects/${nextProject.slug}`)}
      class="book__project-nav book__project-nav--next"
      aria-label={`${t.projectDetail.book.nextProject}: ${nextProject.title}`}
    >
      <span class="book__project-nav-text">
        <span class="label-caps book__project-nav-label">{t.projectDetail.book.nextProject}</span>
        <span class="book__project-nav-title">
          <span class="book__project-nav-name">{nextProject.title}</span>
          <span aria-hidden="true">{String(nextProject.number).padStart(2, "0")}</span>
        </span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</div>

<script>
  // Book page-flip state machine (Revisi klien putaran 2B, diperbaiki di
  // putaran verifikasi-ulang setelah bug report user).
  //
  // BUG #3 root cause (found by reading Astro's own swap-functions.js):
  // this script tag used to be `<script define:vars={{ pageLabelText, ofText
  // }}>`, which bakes each page's localized strings ("Page"/"of" vs
  // "Halaman"/"dari") directly into the script's literal source text. Astro's
  // ClientRouter dedupes inline (non is:inline, no-src) scripts by comparing
  // `script.textContent` against a `Set` of already-seen scripts — see
  // `detectScriptExecuted()` in astro/dist/transitions/swap-functions.js.
  // Two project pages in the SAME language compile to byte-identical script
  // text, so the dedup correctly recognized "already ran" and only the
  // original `astro:page-load` listener (registered on first load) kept
  // firing on every subsequent navigation — this is why testing "next
  // project, same language" repeatedly looked fine.
  //
  // But toggling EN<->ID via the nav bar's language switch is ALSO a
  // client-side ClientRouter navigation, and it produces a script with
  // DIFFERENT literal text (different baked-in words) -> the dedup key
  // differs -> Astro treats it as a brand-new, never-seen script and
  // executes it again, registering a SECOND `astro:page-load` listener
  // (listeners on `document` are never cleaned up across a ClientRouter
  // swap). Each listener keeps its OWN private `current`/`animating`
  // closure state and attaches its OWN click handlers to the same real
  // prev/next buttons. After even one language toggle, a single click fires
  // multiple independent `goTo()` calls with mutually-stale `current`
  // values, which corrupts the class/aria state and reads as "buttons don't
  // respond" / "no flip visible" — exactly the reported symptoms.
  //
  // Fix: never let any per-page-varying value reach this script's literal
  // text. The two localized strings now live in `data-page-label` /
  // `data-of-label` attributes on the `.book` root (read fresh from the DOM
  // on every `astro:page-load` firing, same as `pages`/buttons already
  // were), so the compiled script text is byte-identical on every project,
  // in both languages, and Astro's dedup keeps this to exactly one
  // registered listener. A `window.__bookNavBound` guard is added as a
  // second, independent line of defense in case some future change
  // reintroduces per-page text variance here.
  if (!window.__bookNavBound) {
    window.__bookNavBound = true;

    document.addEventListener("astro:page-load", () => {
      const book = document.querySelector("[data-book]");
      if (!book) return;

      const stage = book.querySelector("[data-book-stage]");
      const pages = Array.from(book.querySelectorAll("[data-book-page]"));
      const total = pages.length;
      if (!stage || total === 0) return;

      const prevBtn = book.querySelector("[data-book-prev]");
      const nextBtn = book.querySelector("[data-book-next]");
      const indicatorNum = book.querySelector("[data-book-indicator-num]");
      const indicatorSr = book.querySelector("[data-book-indicator-sr]");
      const pageLabelText = book.dataset.pageLabel || "Page";
      const ofText = book.dataset.ofLabel || "of";

      const desktopQuery = window.matchMedia("(min-width: 1024px)");

      let current = 0;
      let animating = false;
      // BUG #2 hardening: if `transitionend` AND the setTimeout safety net
      // below both fail to fire — verified reproducible whenever the tab
      // gets backgrounded mid-transition, since browsers throttle/pause
      // rAF, CSS transitions AND timers for hidden documents — `animating`
      // would stay stuck `true` forever, silently no-oping every future
      // click. `pendingFinish`/`transitionStartedAt` let us self-heal: any
      // new navigation attempt, or the tab becoming visible again, force-
      // completes a stale in-flight transition before proceeding.
      let pendingFinish = null;
      let transitionStartedAt = 0;
      const STALE_TRANSITION_MS = 1500; // well above the 620ms/420ms max transition duration

    function upgradeImages(index) {
      [index - 1, index, index + 1].forEach((i) => {
        const page = pages[i];
        if (!page) return;
        page.querySelectorAll('img[loading="lazy"]').forEach((img) => {
          img.loading = "eager";
          if ("decode" in img) img.decode().catch(() => {});
        });
      });
    }

    function setAccessibility(index) {
      pages.forEach((page, i) => {
        if (i === index) {
          page.removeAttribute("aria-hidden");
          page.removeAttribute("inert");
        } else {
          page.setAttribute("aria-hidden", "true");
          page.setAttribute("inert", "");
        }
      });
    }

    function updateIndicator(index) {
      const current1 = String(index + 1).padStart(2, "0");
      const totalLabel = String(total).padStart(2, "0");
      if (indicatorNum) indicatorNum.textContent = `${current1} / ${totalLabel}`;
      if (indicatorSr) {
        indicatorSr.textContent = `${pageLabelText} ${index + 1} ${ofText} ${total}`;
      }
    }

    const transientClasses = [
      "is-flip-out-next",
      "is-flip-out-prev",
      "is-incoming",
      "is-slide-out-next",
      "is-slide-out-prev",
      "is-slide-in-from-right",
      "is-slide-in-from-left",
      "is-slide-settle",
      "is-snapping",
    ];

    function clearTransient(page) {
      page.classList.remove(...transientClasses);
    }

    // See the `pendingFinish`/`transitionStartedAt` comment above — forces a
    // stuck transition to its end state immediately instead of leaving the
    // book permanently unresponsive.
    function forceRecoverIfStale() {
      if (animating && pendingFinish && Date.now() - transitionStartedAt > STALE_TRANSITION_MS) {
        pendingFinish();
      }
    }

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") forceRecoverIfStale();
    });

    function goTo(targetIndex, direction) {
      forceRecoverIfStale();
      if (animating || targetIndex === current || !pages[targetIndex]) return;
      animating = true;
      transitionStartedAt = Date.now();

      const outgoing = pages[current];
      const incoming = pages[targetIndex];
      upgradeImages(targetIndex);

      // Putaran 3 (kehalusan flip): hint the compositor to promote these two
      // pages to their own layers BEFORE any transform/opacity value
      // actually changes below, instead of letting the browser discover the
      // need reactively on the first animation frame (that reactive
      // promotion is a common cause of a jerky first frame on a 3D
      // transform). Cleared again in finish() — never left on permanently,
      // since a `will-change` hint left on many/all pages would itself cost
      // memory for no benefit outside an active transition.
      outgoing.style.willChange = "transform, opacity";
      incoming.style.willChange = "transform, opacity";

      let settled = false;
      function finish() {
        if (settled) return;
        settled = true;
        outgoing.classList.remove("is-active");
        clearTransient(outgoing);
        incoming.classList.add("is-active");
        clearTransient(incoming);
        outgoing.style.willChange = "";
        incoming.style.willChange = "";
        current = targetIndex;
        setAccessibility(current);
        updateIndicator(current);
        animating = false;
        pendingFinish = null;
        incoming.focus({ preventScroll: true });
        outgoing.removeEventListener("transitionend", onEnd);
        // Putaran 3: re-assert the eager/decode hint for the NEW current
        // page's neighbors once we land here, not just for the page we
        // were headed to when this transition started. Without this, the
        // neighbor-preload chain only ever extends one hop per click (the
        // page 2-away from wherever the visitor started never gets its
        // decode() kicked off until a transition toward it is already
        // under way), so fast repeated next/next/next clicks could hit an
        // image that's still mid-decode when its flip begins. Idempotent —
        // re-marking an already-eager <img> or re-calling decode() on an
        // already-decoded one is a no-op cost.
        upgradeImages(current);
      }
      pendingFinish = finish;

      function onEnd(event) {
        if (event.target !== outgoing) return;
        if (event.propertyName !== "transform" && event.propertyName !== "opacity") return;
        finish();
      }

      if (desktopQuery.matches) {
        incoming.classList.add("is-incoming");
        // Force layout so the "incoming" state above is committed before the
        // outgoing page starts its rotateY transition on the next line.
        void incoming.offsetWidth;
        outgoing.classList.add(direction === "next" ? "is-flip-out-next" : "is-flip-out-prev");
      } else {
        incoming.classList.add("is-snapping");
        incoming.classList.add(
          direction === "next" ? "is-slide-in-from-right" : "is-slide-in-from-left"
        );
        void incoming.offsetWidth;
        incoming.classList.remove("is-snapping");
        requestAnimationFrame(() => {
          outgoing.classList.add(direction === "next" ? "is-slide-out-next" : "is-slide-out-prev");
          incoming.classList.add("is-slide-settle");
        });
      }

      outgoing.addEventListener("transitionend", onEnd);
      // Safety net: if transitionend never fires (e.g. the element was
      // display:none for some reason, or reduced-motion collapses the
      // transition faster than the browser reports it), finish anyway.
      window.setTimeout(finish, 900);
    }

    function next() {
      goTo((current + 1) % total, "next");
    }
    function prev() {
      goTo((current - 1 + total) % total, "prev");
    }

    prevBtn?.addEventListener("click", prev);
    nextBtn?.addEventListener("click", next);

    book.addEventListener("keydown", (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest("input, textarea, select, [contenteditable]")) {
        return;
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        next();
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        prev();
      }
    });

    // Simple, "committed" touch swipe (down/up delta, not live-dragging) —
    // per client spec ("swipe/geser horizontal sederhana"). touch-action:
    // pan-y (global.css) leaves native vertical scroll alone and hands
    // horizontal gestures to us instead.
    let touchStartX = null;
    stage.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "touch") return;
      touchStartX = event.clientX;
    });
    stage.addEventListener("pointerup", (event) => {
      if (event.pointerType !== "touch" || touchStartX === null) return;
      const dx = event.clientX - touchStartX;
      touchStartX = null;
      if (Math.abs(dx) < 40) return;
      if (dx < 0) next();
      else prev();
    });

    setAccessibility(0);
    updateIndicator(0);
    upgradeImages(0);
    });
  }
</script>
