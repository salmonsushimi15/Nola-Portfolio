---
import SectionNumber from "../SectionNumber.astro";
import type { Lang } from "../../i18n/paths";
import type { about as aboutEn } from "../../i18n/en/about";

interface Props {
  lang: Lang;
  content: typeof aboutEn;
}

const { content: about } = Astro.props;
---

<!-- Intro -->
<section class="content-wrap py-16 sm:py-20">
  <p class="label-caps text-sm text-terracotta-deep">{about.intro.eyebrow}</p>
  <h1 class="mt-4 max-w-2xl text-4xl font-bold sm:text-5xl">
    {about.intro.heading}
  </h1>
  <p class="mt-6 max-w-2xl text-base text-ink/70 sm:text-lg">
    {about.intro.summary}
  </p>
  <ul class="mt-6 flex flex-wrap gap-3">
    {
      about.intro.tags.map((tag) => (
        <li class="label-caps rounded-full border border-ink/15 px-4 py-2 text-xs text-ink/70">
          {tag}
        </li>
      ))
    }
  </ul>
</section>

<!-- Education -->
<section class="bg-cream-panel py-16 sm:py-20">
  <div class="content-wrap">
    <SectionNumber number={1} label={about.education.label} size="sm" />
    <ul class="mt-8 flex flex-col gap-8">
      {
        about.education.items.map((item) => (
          <li class="border-l-2 border-terracotta pl-6">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <h3 class="text-lg font-semibold text-ink">{item.institution}</h3>
              <p class="label-caps shrink-0 text-xs text-terracotta-deep">{item.dates}</p>
            </div>
            <p class="mt-1 text-sm text-ink/80">{item.program}</p>
            {item.notes.length > 0 && (
              <ul class="mt-3 flex flex-col gap-1.5 text-sm text-ink/70">
                {item.notes.map((note) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-terracotta">—</span>
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Experience -->
<section class="py-16 sm:py-20">
  <div class="content-wrap">
    <SectionNumber number={2} label={about.experience.label} size="sm" />
    <ul class="mt-8 flex flex-col gap-10">
      {
        about.experience.items.map((item) => (
          <li class="border-l-2 border-terracotta pl-6">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <div>
                <h3 class="text-lg font-semibold text-ink">{item.company}</h3>
                <p class="text-sm text-ink/80">{item.role}</p>
              </div>
              <p class="label-caps shrink-0 text-xs text-terracotta-deep">{item.dates}</p>
            </div>
            <ul class="mt-3 flex flex-col gap-1.5 text-sm text-ink/70">
              {item.bullets.map((bullet) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-terracotta">—</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-sm font-semibold text-ink">
              <span class="label-caps mr-2 text-xs font-semibold text-terracotta-deep">
                {about.experience.achievementLabel}
              </span>
              {item.achievement}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Design Philosophy -->
<section class="bg-terracotta py-16 text-cream sm:py-20">
  <div class="content-wrap">
    <SectionNumber number={3} label={about.philosophy.label} size="sm" tone="inverted" />
    <blockquote class="mt-8 max-w-3xl text-2xl font-semibold leading-snug sm:text-3xl">
      &ldquo;{about.philosophy.quote}&rdquo;
    </blockquote>
  </div>
</section>

<!-- Skills -->
<section class="bg-cream-panel py-16 sm:py-20">
  <div class="content-wrap">
    <SectionNumber number={4} label={about.skills.label} size="sm" />
    <div class="mt-8 grid gap-10 sm:grid-cols-3">
      <div>
        <h3 class="label-caps text-xs text-ink/70">{about.skills.hard.title}</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            about.skills.hard.items.map((skill) => (
              <li class="rounded-full bg-cream px-3 py-1.5 text-sm text-ink">{skill}</li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="label-caps text-xs text-ink/70">{about.skills.soft.title}</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {
            about.skills.soft.items.map((skill) => (
              <li class="rounded-full bg-cream px-3 py-1.5 text-sm text-ink">{skill}</li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3 class="label-caps text-xs text-ink/70">{about.skills.languages.title}</h3>
        <ul class="mt-4 flex flex-col gap-2 text-sm text-ink">
          {
            about.skills.languages.items.map((lang) => (
              <li class="flex items-baseline justify-between gap-4 rounded-full bg-cream px-3 py-1.5">
                <span>{lang.name}</span>
                <span class="label-caps text-xs text-ink/70">{lang.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Research & Publications -->
<section class="py-16 sm:py-20">
  <div class="content-wrap">
    <SectionNumber number={5} label={about.research.label} size="sm" />
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        about.research.items.map((item) => (
          <article class="flex flex-col gap-3 bg-cream-panel p-6">
            <div class="flex items-baseline justify-between gap-4">
              <p class="label-caps text-xs text-terracotta-deep">{item.type}</p>
              <p class="label-caps text-xs text-ink/70">{item.date}</p>
            </div>
            <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
            <p class="text-sm text-ink/70">{item.description}</p>
            <p class="text-sm font-semibold text-ink">{item.achievement}</p>
            {item.link && (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="label-caps mt-1 inline-flex min-h-11 w-fit items-center gap-2 text-xs text-terracotta-deep transition-colors hover:text-terracotta"
              >
                {about.research.readPublicationLabel}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
