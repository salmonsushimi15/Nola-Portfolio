---
/**
 * Site footer — contact channels per PRD Bagian 1 (kontak klien, FIXED).
 * Icons are hand-authored inline SVG (Lucide-style outline), no emoji.
 * Contact values themselves (email/phone/handles) aren't translated —
 * only the surrounding tagline/copyright text is.
 */
import { getUi } from "../i18n/getUi";
import type { Lang } from "../i18n/paths";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);

const year = new Date().getFullYear();

const contacts = [
  {
    label: "nola.amallia15@gmail.com",
    href: "mailto:nola.amallia15@gmail.com",
    icon: "mail" as const,
  },
  {
    label: t.contactChannels.whatsappLabel,
    // Revisi klien putaran 2A, poin 6: phone display replaced with a
    // WhatsApp deep link (opens a chat directly) — the raw number is kept
    // as visible `sublabel` text so anyone who wants to dial manually still
    // can. https:// href means the generic target/rel logic below already
    // opens it in a new tab with rel="noopener".
    sublabel: "+62 823-7348-7727",
    href: "https://wa.me/6282373487727",
    icon: "whatsapp" as const,
  },
  {
    label: "linkedin.com/in/nolaamallia",
    href: "https://linkedin.com/in/nolaamallia",
    icon: "linkedin" as const,
  },
  {
    label: "@nolaamp",
    href: "https://instagram.com/nolaamp",
    icon: "instagram" as const,
  },
];
---

<footer class="border-t border-ink/10 bg-cream-panel">
  <div class="content-wrap grid gap-10 py-14 md:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="text-xl font-semibold text-ink">Nola Amallia Putri</p>
      <p class="mt-3 max-w-sm text-sm text-ink/70">
        {t.footer.tagline}
      </p>
    </div>

    <ul class="flex flex-col gap-3">
      {
        contacts.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.href.startsWith("http") ? "_blank" : undefined}
              rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="group inline-flex min-h-11 items-center gap-3 text-sm text-ink transition-colors hover:text-terracotta-deep"
            >
              <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cream text-terracotta transition-colors group-hover:bg-terracotta group-hover:text-cream">
                {c.icon === "mail" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="20" height="16" x="2" y="4" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                )}
                {c.icon === "whatsapp" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12.04 2.003c-5.46 0-9.9 4.44-9.9 9.9 0 1.746.457 3.436 1.324 4.923L2 22l5.29-1.388a9.86 9.86 0 0 0 4.75 1.21h.004c5.46 0 9.9-4.44 9.9-9.9 0-2.645-1.03-5.13-2.9-6.998a9.83 9.83 0 0 0-6.998-2.9zm0 18.116h-.003a8.2 8.2 0 0 1-4.183-1.146l-.3-.178-3.12.818.833-3.043-.196-.312a8.2 8.2 0 0 1-1.256-4.36c0-4.54 3.696-8.235 8.238-8.235 2.2 0 4.267.857 5.823 2.415a8.18 8.18 0 0 1 2.412 5.827c0 4.54-3.696 8.234-8.248 8.234zm4.522-6.163c-.248-.124-1.467-.723-1.694-.807-.227-.083-.393-.124-.558.125-.166.248-.64.806-.784.972-.145.166-.29.187-.538.062-.248-.125-1.047-.386-1.994-1.23-.737-.657-1.235-1.47-1.38-1.718-.145-.248-.016-.382.109-.506.112-.111.248-.29.373-.435s.166-.248.25-.414c.083-.166.041-.31-.02-.435-.063-.124-.559-1.347-.765-1.845-.202-.485-.407-.42-.559-.428l-.475-.008a.91.91 0 0 0-.66.31c-.227.248-.868.848-.868 2.068 0 1.22.888 2.399 1.012 2.565.124.166 1.748 2.669 4.236 3.742.592.256 1.053.408 1.413.522.594.189 1.134.162 1.561.099.476-.071 1.467-.6 1.674-1.18.207-.58.207-1.077.145-1.18-.062-.104-.227-.166-.475-.29z" />
                  </svg>
                )}
                {c.icon === "linkedin" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                    <rect width="4" height="12" x="2" y="9" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}
                {c.icon === "instagram" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
                  </svg>
                )}
              </span>
              <span class="flex flex-col leading-tight">
                <span>{c.label}</span>
                {"sublabel" in c && c.sublabel && (
                  <span class="text-xs text-ink/50 group-hover:text-terracotta-deep/70">
                    {c.sublabel}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-ink/10">
    <div class="content-wrap flex flex-col gap-2 py-6 text-xs text-ink/70 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Nola Amallia Putri. {t.footer.rights}</p>
      <p>Bandar Lampung, Indonesia</p>
    </div>
  </div>
</footer>
