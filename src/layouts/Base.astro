---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import IntroOverlay from "../components/IntroOverlay.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import "../styles/global.css";
import { getUi } from "../i18n/getUi";
import { getLocalizedPath, type Lang } from "../i18n/paths";

interface Props {
  /** Page <title>. Site name is appended automatically. */
  title: string;
  /** Meta description, ~150-160 chars, unique per page. */
  description: string;
  /** Optional Open Graph image path (absolute URL or root-relative). Falls back to default OG image. */
  ogImage?: string;
  /** BCP-47 language code. Default "en" — EN lives at "/", ID mirrors under "/id/..." (Tahap 5). */
  lang?: Lang;
}

const {
  title,
  description,
  ogImage = "/og-default.jpg",
  lang = "en",
} = Astro.props;

const t = getUi(lang);

const siteName = "Nola Amallia Putri — Architect Portfolio";
const pageTitle = title ? `${title} | ${siteName}` : siteName;
// Astro.site is undefined until the production domain (Tahap 7) is set in
// astro.config.mjs — fall back to the current request URL so build/dev
// keep working with absolute URLs either way.
const urlBase = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, urlBase);
const ogImageURL = new URL(ogImage, urlBase);

// hreflang alternates — same content in both languages, just a different path.
const enHref = new URL(getLocalizedPath(Astro.url.pathname, "en"), urlBase);
const idHref = new URL(getLocalizedPath(Astro.url.pathname, "id"), urlBase);

const ogLocale = lang === "id" ? "id_ID" : "en_US";
const ogLocaleAlternate = lang === "id" ? "en_US" : "id_ID";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Gates the [data-reveal] scroll-animation CSS (global.css), plus the
         book-style project detail pagination (ProjectDetailTemplate.astro /
         global.css `html.js .book__page` etc.), behind JS support.

         BUG FIX (found while investigating a user report that book flip/prev-
         next controls "stopped working" after browsing around, and that the
         flip was never visible): `<html>` itself persists across
         `<ClientRouter />` swaps, but its ATTRIBUTES do not merge additively —
         Astro's swapRootAttributes() (astro/dist/transitions/swap-functions.js)
         removes every current attribute on <html> and re-applies only the
         freshly-fetched document's own html-tag attributes (plus a couple of
         internal astro-transition-* ones). Since class="js" was only ever
         added here by this script (never part of the server-rendered <html>
         tag), every client-side navigation wiped it straight back off. This
         script itself only runs ONCE per session (Astro dedupes identical
         inline scripts across pages), so nothing was re-adding it — the whole
         site silently fell back to its no-JS layout after literally any
         client-side nav (including the EN/ID language toggle), which is why
         the book's flip/prev/next appeared to work once, then "break". Fixed
         by re-asserting the class on `astro:after-swap`, which Astro fires
         right after each swap and always before `astro:page-load` — so every
         `.js`-gated feature sees the class back in place before it re-inits. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.add("js");
      });
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#bc5a34" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- i18n: route-based EN (/) + ID (/id/...) mirrors, same slugs -->
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="id" href={idHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Cross-fade page transitions (Revisi poin 2). Intro overlay + mobile
         nav toggle re-init on `astro:page-load`, which this also emits on the
         very first load, so no separate DOMContentLoaded path is needed. -->
    <ClientRouter />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-cream text-ink">
    <IntroOverlay lang={lang} />

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-terracotta-deep focus:px-4 focus:py-2 focus:text-cream"
    >
      {t.skipToContent}
    </a>

    <Nav lang={lang} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
    <ScrollReveal />
  </body>
</html>
